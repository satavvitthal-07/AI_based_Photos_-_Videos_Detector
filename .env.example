# Detector activation is intentionally opt-in.
# Verify the model card, intended task, exact output labels, license, inference API
# and suitability for authenticity screening before setting these values.
TRUTHLENS_MODEL_ID=
TRUTHLENS_MODEL_REVISION=
TRUTHLENS_MODEL_VERIFIED=false
TRUTHLENS_AI_LABELS=

# Optional educational candidate reviewed by this project:
# https://huggingface.co/Organika/sdxl-detector
# Its card describes an SDXL-focused AI-art detector; exact labels are
# "artificial" and "human". The card cautions that inherited training data may
# make it suitable only for non-commercial educational/personal use.
# TRUTHLENS_MODEL_ID=Organika/sdxl-detector
# TRUTHLENS_MODEL_REVISION=b37fede8562cb72b89ec201c0987f96ba21b518a
# TRUTHLENS_MODEL_VERIFIED=true
# TRUTHLENS_AI_LABELS=artificial

# Optional comma-separated browser origins for a separate frontend dev server.
TRUTHLENS_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
# Optional database path. Defaults to backend/truthlens.sqlite3.
# TRUTHLENS_DATABASE=
